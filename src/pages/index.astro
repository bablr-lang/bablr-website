---
import Layout from "../layouts/Layout.astro";
import TableCard from "../components/TableCard.astro";
import Card from "../components/Card.astro";
import CTAButton from "../components/CTAButton.astro";
import Thumbnail from "../components/Thumbnail.astro";
import playgroundThumb from "../images/thumbnails/playground.png";
import paneditorThumb from "../images/thumbnails/paneditor.png";
---

<Layout title="BABLR">
  <h1>Welcome to &lt;<span class="text-gradient">BABLR</span>/&gt;</h1>
  <div class="link-container">
    <ul role="list" class="link-card-grid">
      <Card
        href="https://github.com/bablr-lang"
        title="Github"
        body="Learn about BABLR and its mission."
      />
      <Card
        href="https://discord.gg/pTbg4JGEZp"
        title="Community"
        body="Join our Discord and help with the development."
      />
      <Card
        href="/playground"
        title="Playground"
        body="Check out bablr's features and write your first grammar!"
      />
      <Card
        href="/philosophy"
        title="Philosophy"
        body="The Bablr philosophy."
      />
    </ul>
  </div>
  <div class="tpl-table">
    <div class="table-container">
      <TableCard
        title="Tools"
        audience="Tool Authors"
        items={[
          "Want to be able to support new languages after the fact",
          "Want to be able to define custom tools, e.g. type-aware linting",
          "Want to be able to define tools that can work on infinite inputs and those larger than system memory",
          "Want to be able to interoperate naturally e.g. `format(fixLintErrors(code))`",
          "Developers want to use trusted tools when working on new languages",
        ]}
      />
      <TableCard
        title="Platform"
        audience="IDE Developers"
        items={[
          "Existing platforms: LSP, ANTLR, Tree-sitter, TextMate",
          "Supports different UX modes: voice coding, gesture coding, terminal editing, online collab, interactive devtools, etc",
          "",
        ]}
      />
      <TableCard
        title="Languages"
        audience="Language Authors"
        items={[
          "Want to define languages in a way that supports tools that haven’t been made yet",
          "Want to be able to create new languages by extending existing ones",
        ]}
      />
    </div>
  </div>
  <div class="experiments">
    <h2>Experiments</h2>
    <div class="thumb-container">
      <Thumbnail
        href="/playground"
        title="Playground"
        alt="A thumbnail of the playground"
        thumbnail={playgroundThumb}
      />
      <Thumbnail
        href="https://paned.it/"
        title="Paneditor"
        alt="A thumbnail of paneditor"
        thumbnail={paneditorThumb}
      />
    </div>
  </div>
  <div class="roadmap">
    <div class="content">
      <div class="text-space">
        <h2>Roadmap</h2>
        <p>Where are we going?<br />Where have we been?</p>
      </div>
      <div class="button-space">
        <CTAButton href="/roadmap" text="explore" />
      </div>
    </div>
  </div>
</Layout>

<style>
  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
    gap: 2rem;
    padding: 0;
    max-width: 700px;
    margin: auto;
  }
  .link-container {
    padding-bottom: 4rem;
    max-width: calc(100% - 2rem);
    margin: auto;
  }

  .thumb-container {
    display: flex;
    flex-flow: column;
    justify-content: center;
    margin: auto;
    padding: 2rem 0rem 2rem;
    gap: 3rem;
  }

  .experiments {
    background: var(--background02);
    text-align: center;
    padding: 2rem 0rem 2rem;
  }
  .experiments h2 {
    font-size: 3rem;
  }

  .roadmap {
    padding: 4rem 0;
    color: #268bd2;
    text-align: center;
    display: block;
  }
  .roadmap .content {
    margin: auto;
    font-size: x-large;
    max-width: calc(100% - 2rem);
  }
  .roadmap .text-space {
    margin: auto;
  }
  .roadmap .button-space {
    align-content: center;
    margin: auto;
  }
  .roadmap h2 {
    font-size: 3rem;
    margin: 0;
  }

  @media screen and (min-width: 636px) {
    .thumb-container {
      display: flex;
      flex-flow: row;
      background: var(--background02);
      justify-content: center;
      margin: auto;
      padding: 2rem 0rem 2rem;
    }

    .roadmap {
      padding: 4rem 0;
      color: #268bd2;
      display: flex;
      width: 100%;
      text-align: left;
    }
    .roadmap .content {
      margin: auto;
      font-size: x-large;
      width: 1060px;
      display: flex;
    }
    .roadmap .text-space {
      margin: auto;
    }
    .roadmap .button-space {
    }

    .table-container {
      display: flex;
      flex-flow: row;
      padding-bottom: 2rem;
    }
    .tpl-table {
      margin: auto;
      justify-items: center;
    }
  }
</style>
