---
import { ChevronRight, Code } from "lucide-astro";
import DemoText from "./solid/DemoText.jsx";
---

<div class="max-w-6xl mx-auto px-4 py-20">
  <h1 class="text-6xl font-bold text-center mb-8">
    <span class="relative -z-1">
      <span class="welcome inline-block" style="margin-right: .8ex"
        >Welcome to</span
      ><span class="font-kronika text-orange-400"
        ><DemoText text="<BABLR>" client:only="solid" /></span
      >
    </span>
  </h1>
  <p class="text-xl text-center text-gray-600 mb-12">
    The next-gen LR parser framework for creating elegant and efficient language
    tools
  </p>
  <div class="flex justify-center space-x-6">
    <a
      href="https://docs.bablr.org"
      target="_blank"
      rel="noopener noreferrer"
      class="bg-orange-500 text-white px-4 md:px-8 py-3 rounded-lg flex items-center space-x-2 hover:bg-orange-600 text-xs md:text-base cursor-pointer"
    >
      <span>Get Started</span>
      <ChevronRight size={20} />
    </a>
  </div>
</div>
