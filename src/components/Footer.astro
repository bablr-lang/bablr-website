---
import { Github } from "lucide-astro";
---

<footer class="border-t border-gray-200 mt-20 py-4">
  <div class="max-w-6xl mx-auto px-4 flex justify-between items-center">
    <div class="text-sm text-gray-600">Copyright © 2024</div>
    <div class="text-xs text-gray-600 text-center">
      <div class="mb-1">
        site design by <a
          class="hover:text-orange-500"
          href="https://github.com/neonbhai">LordNeo</a
        > and <a
          class="hover:text-orange-500"
          href="https://github.com/stirlhoss">Stirlhoss</a
        >; logo design by <a
          class="hover:text-orange-500"
          href="https://github.com/notchris">NotChris</a
        >.
      </div>
      <div>
        invented by <a
          class="hover:text-orange-500"
          href="https://github.com/conartist6">conartist6</a
        >. thank you to all our contributors!
      </div>
    </div>
    <div class="flex space-x-4">
      <a
        href="https://github.com/bablr-lang"
        class="text-gray-600 hover:text-orange-500"
      >
        <Github size={24} />
      </a>
    </div>
  </div>
</footer>
