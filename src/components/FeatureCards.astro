---
import { Github, Users, BookOpen } from "lucide-react";
---

<div class="max-w-6xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
  <a href="https://github.com/bablr-lang" target="_blank" rel="noopener noreferrer" class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow cursor-default">
    <div class="text-orange-500 mb-4">
      <Github size={48} />
    </div>
    <h3 class="text-xl font-bold mb-2">Open Source</h3>
    <p class="text-gray-600">
      Learn about BABLR and its mission. Contribute to our growing community.
    </p>
  </a>

  <a href="https://discord.gg/pTbg4JGEZp" target="_blank" rel="noopener noreferrer" class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow cursor-default">
    <div class="text-orange-500 mb-4">
      <Users size={48} />
    </div>
    <h3 class="text-xl font-bold mb-2">Community</h3>
    <p class="text-gray-600">
      Join our Discord and help shape the future of language parsing.
    </p>
  </a>

  <a href="https://docs.bablr.org" target="_blank" rel="noopener noreferrer" class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow cursor-default">
    <div class="text-orange-500 mb-4">
      <BookOpen size={48} />
    </div>
    <h3 class="text-xl font-bold mb-2">Documentation</h3>
    <p class="text-gray-600">
      Comprehensive guides and examples to get you started quickly.
    </p>
  </a>
</div>
