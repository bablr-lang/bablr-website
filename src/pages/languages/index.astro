---
import Layout from '../../layouts/Layout.astro'
import LanguageCard from '../../components/LanguageCard.astro'

const response = await fetch('https://api.github.com/orgs/bablr-lang/repos')

const data = await response.json();

const allLangs = data.filter((repo) => repo.name.includes("language-en"));
---

<Layout title="Languages">
	<main class="min-h-screen py-12 px-4 sm:px-8">
		<h1 class="text-6xl sm:text-5xl font-bold text-center mb-12">
		  BABLR Languages
		</h1>
		<ul class="space-y-4 max-w-2xl mx-auto">
		  {allLangs.map((repo) => (
			<LanguageCard key={repo.name} href={`languages/${repo.name}`} language={repo.name} />
		  ))}
		</ul>
	  </main>
</Layout>

