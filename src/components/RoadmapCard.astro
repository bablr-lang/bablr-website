---
import RoadmapCategory from "./RoadmapCategory.astro";
import RoadmapHeader from "./RoadmapHeader.astro";
import { roadmapData } from "../data/roadmap";
---

<div class="max-w-6xl mx-auto px-4 py-16">
  <div class="bg-white rounded-xl p-8 shadow-lg">
    <RoadmapHeader />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {roadmapData.map((category) => <RoadmapCategory {...category} />)}
    </div>
  </div>
</div>
