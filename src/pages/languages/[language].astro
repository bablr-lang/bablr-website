---
import Layout from "../../layouts/Layout.astro";
const { language } = Astro.params;
---

<Layout title="language">
	<main class="px-4">
		<h1 class="text-6xl text-center sm:text-5xl font-bold mb-12">{language}</h1>
		<div>
			<a href={`https://github.com/bablr-lang/${language}`}><h3>Github</h3></a>
		</div>
	</main>
</Layout>
