---
import Layout from "../layouts/Layout.astro";
import TableCard from "../components/TableCard.astro";
import Card from "../components/Card.astro";
import CTAButton from "../components/CTAButton.astro";
import Thumbnail from "../components/Thumbnail.astro";
import playgroundThumb from "../images/thumbnails/playground.png";
import paneditorThumb from "../images/thumbnails/paneditor.png";
import openCollective from "../images/icons/open-collective.svg";
---

<Layout title="BABLR">
  <h1>Welcome to &lt;<span class="text-gradient">BABLR</span>/&gt;</h1>
  <div class="link-container">
    <ul role="list" class="link-card-grid">
      <Card
        href="https://github.com/bablr-lang"
        title="Github"
        body="Learn about BABLR and its mission."
      />
      <Card
        href="https://discord.gg/pTbg4JGEZp"
        title="Community"
        body="Join our Discord and help with the development."
      />
      <Card
        href="/playground"
        title="Playground"
        body="Check out bablr's features and write your first grammar!"
      />
      <Card
        href="/philosophy"
        title="Philosophy"
        body="The Bablr philosophy."
      />
      <Card
        href="https://opencollective.com/bablr"
        title="Open Collective"
        body="Support BABLR financially."
      />
    </ul>
  </div>
  <div class="tpl-table">
    <h2>Something for everyone...</h2>
    <div class="table-container">
      <TableCard
        title="Tool Authors"
        items={[
          "Support new languages after the fact",
          "Define custom tools, e.g. type-aware linting",
          "Define tools that can work on infinite inputs and those larger than system memory",
          "Interoperate naturally",
          "Developers want to use trusted tools when working on new languages",
        ]}
      />
      <TableCard title="IDE Developers" items={[]}>
        <ul slot="special-list-early">
          <li>
            Existing platforms use a mix of tooling like: LSP, ANTLR,
            Tree-sitter, TextMate
          </li>
          <li><b>Our platform consists of:</b></li>
          <ul>
            <li><b>CSTML:</b> An untyped document format akin to XML/JSON</li>
            <li>
              <b>BABLR:</b> A parser-based schema validator for CSTML documents
            </li>
            <li>
              <b>Paneditor:</b> A web UI for semantic coding built on BABLR
            </li>
          </ul>
          <li>
            <b>So we can support multiple UX modes:</b>
            <ul>
              <li>Voice gesture</li>
              <li>Terminal editing</li>
              <li>Online collaboration</li>
              <li>Interactive devtools</li>
            </ul>
          </li>
        </ul>
      </TableCard>
      <TableCard
        title="Language Authors"
        items={[
          "Define languages in a way that supports tools that haven’t been made yet",
          "Create new languages by extending existing ones",
        ]}
      >
        <ul slot="special-list-late">
          <li><b>Designing tools that make it easy to:</b></li>
          <ul>
            <li>Parse left to right (like people do)</li>
            <li>Perform arbitrary lookahead</li>
            <li>Maintain balanced spans</li>
            <li>Generate helpful parse errors</li>
            <li>Regex matching</li>
            <li>Just-in-time tokenization</li>
            <li>Skip the build step</li>
            <li>Get the most out of Devtools</li>
          </ul>
        </ul>
      </TableCard>
    </div>
  </div>
  <div class="experiments">
    <h2>Experiments</h2>
    <div class="thumb-container">
      <Thumbnail
        href="/playground"
        title="Playground"
        alt="A thumbnail of the playground"
        thumbnail={playgroundThumb}
      />
      <Thumbnail
        href="https://paned.it/"
        title="Paneditor"
        alt="A thumbnail of paneditor"
        thumbnail={paneditorThumb}
      />
    </div>
  </div>
  <div class="roadmap">
    <div class="content">
      <div class="text-space">
        <h2>Roadmap</h2>
        <p>Where are we going?<br />Where have we been?</p>
      </div>
      <div class="button-space">
        <CTAButton href="/roadmap" text="explore" />
      </div>
    </div>
  </div>
</Layout>

<style>
  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
  .link-card-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
    gap: 2rem;
    padding: 0;
    max-width: 1080px;
    margin: auto;
  }
  .link-container {
    padding-bottom: 4rem;
    max-width: calc(100% - 2rem);
    margin: auto;
  }

  .thumb-container {
    display: flex;
    flex-flow: column;
    justify-content: center;
    margin: auto;
    padding: 2rem 0rem 2rem;
    gap: 3rem;
  }

  .experiments {
    background: var(--background02);
    text-align: center;
    padding: 2rem 0rem 2rem;
  }
  h2 {
    font-size: 3rem;
  }

  .roadmap {
    padding: 4rem 0;
    color: #268bd2;
    text-align: center;
    display: block;
  }
  .roadmap .content {
    margin: auto;
    font-size: x-large;
    max-width: calc(100% - 2rem);
  }
  .roadmap .text-space {
    margin: auto;
  }
  .roadmap .button-space {
    align-content: center;
    margin: auto;
  }
  .roadmap h2 {
    font-size: 3rem;
    margin: 0;
  }

  @media screen and (min-width: 636px) {
    .thumb-container {
      display: flex;
      flex-flow: row;
      background: var(--background02);
      justify-content: center;
      margin: auto;
      padding: 2rem 0rem 2rem;
    }

    .roadmap {
      padding: 4rem 0;
      color: #268bd2;
      display: flex;
      width: 100%;
      text-align: left;
    }
    .roadmap .content {
      font-size: x-large;
      width: 1080px;
      display: flex;
    }
    .roadmap .text-space {
      display: flex;
      flex-direction: column;
    }
    .roadmap .button-space {
      display: flex;
      align-items: right;
    }

    .table-container {
      display: flex;
      flex-flow: row;
      padding-bottom: 2rem;
    }
    .tpl-table {
      margin: auto;
      justify-items: center;
      display: grid;
    }
  }
</style>
