---
import { ChevronRight, Code } from "lucide-react";
import ColourfulText from "./react/ColourfulText.jsx";
---

<div class="max-w-6xl mx-auto px-4 py-20">
    <h1 class="text-6xl font-bold text-center mb-8">
      Welcome to{" "}
      <span class="text-orange-400 font-kronika whitespace-nowrap relative -z-1">
        <ColourfulText text="<BABLR>" client:only="react"/>
      </span>
    </h1>
    <p class="text-xl text-center text-gray-600 mb-12">
      The next generation parser generator for creating elegant and
      efficient language tools
    </p>
    <div class="flex justify-center space-x-6">
      <a href="https://docs.bablr.org" target="_blank" rel="noopener noreferrer" class="bg-orange-500 text-white px-4 md:px-8 py-3 rounded-lg flex items-center space-x-2 hover:bg-orange-600 text-xs md:text-base cursor-pointer">
        <span>Get Started</span>
        <ChevronRight size={20} />
      </a>
      <a href="/playground" class="border-2 border-orange-500 text-orange-500 px-4 md:px-8 py-3 rounded-lg flex items-center space-x-2 hover:bg-orange-50 text-xs md:text-base cursor-pointer">
        <span>Try Playground</span>
        <Code size={20} />
      </a>
    </div>
</div>