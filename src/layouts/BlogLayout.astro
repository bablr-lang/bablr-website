---
import Layout from "./Layout.astro"

const {frontmatter} = Astro.props
---

<Layout title={frontmatter.title}>
  <div class="px-6 py-20 text-gray-800">
    <div class="max-w-3xl mx-auto">
      <div class="mb-12 text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-tight mb-2">
          {frontmatter.title}
        </h1>
        <div class="text-sm text-gray-600">
          <span class="italic text-orange-700">{frontmatter.author}</span>
          <span class="pl-2 text-gray-500">{frontmatter.date}</span>
        </div>
      </div>

      <div class="blog-content">
        <slot />
      </div>
    </div>
  </div>
</Layout>
