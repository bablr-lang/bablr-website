---
import { audiences } from "../data/audiences";
const cards = [
  {
    id: "tool",
    title: "Tool Authors",
    description:
      "Create and maintain tools with powerful abstractions and simplified workflows.",
    ...audiences.tool,
  },
  {
    id: "ide",
    title: "IDE Developers",
    description:
      "Build rich editing experiences with comprehensive language support.",
    ...audiences.ide,
  },
  {
    id: "lang",
    title: "Language Authors",
    description:
      "Design and implement languages with sophisticated parsing capabilities.",
    ...audiences.lang,
  },
];
---

<div class="w-full max-w-6xl mx-auto py-12 px-4 text-center">
  <h2 class="text-4xl font-bold text-gray-900 py-2">
    Our APIs get out of your way so you can write code
  </h2>
  <p class="text-gray-600">
    We're building an API-first IDE centered around a <a
      class="hover:text-orange-600"
      href="https://developer.mozilla.org/en-US/docs/Web/API/Document_Object_Model/Introduction"
      >Document Object Model</a
    > (or DOM) for code. We hope to create a new generation of tools that are more
    trustworthy, transparent, powerful, and approachable in order to make software
    literacy less rare. We believe when that software literacy is rare the incentives
    are strong for software to be used to manipulate people rather than to serve
    them.
  </p>
</div>
<div
  class="w-full max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-10 px-4"
>
  {
    cards.map((card) => {
      const IconComponent = card.icon;

      return (
        <div
          class={`bg-white rounded-xl border ${card.borderColor} ${card.shadowColor} shadow-lg p-6 flex flex-col items-center justify-center transition-all duration-300 hover:shadow-xl hover:translate-y-1 cursor-pointer`}
        >
          <div class={`p-4 rounded-full ${card.color} mb-4`}>
            <IconComponent size={48} />
          </div>
          <h3 class="text-xl font-semibold text-gray-800 text-center">
            {card.title}
          </h3>
          <p class="mt-2 text-gray-600 text-center text-sm">
            {card.description}
          </p>
        </div>
      );
    })
  }
</div>
