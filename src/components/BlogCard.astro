---
const { href, title, date, author } = Astro.props;
---

<a
  href={href}
  class="block p-6 bg-white/60 backdrop-blur-md shadow-md rounded-2xl border border-white/30 transition-all duration-300 ease-out hover:scale-[1.03] hover:shadow-lg hover:shadow-orange-200 hover:border-orange-300 hover:bg-white/70"
>
  <h2 class="text-2xl font-semibold text-gray-900 mb-2">{title}</h2>
  <p class="text-sm text-gray-600 mb-1">{author}</p>
  <p class="text-sm text-gray-500">{new Date(date).toLocaleDateString()}</p>
</a>
